{
  "name": "dsh-context-rescue",
  "version": "0.2.4",
  "description": "给爆窗的 DSH 会话叫救护车：识别上下文溢出、把最老的历史折叠成结构化摘要、原步重试一次。 Emergency rescue for DeepSeek Harness sessions that hit the model context window.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./lib/*": "./lib/*"
  },
  "files": [
    "index.js",
    "lib/",
    "cordis.patch.yml",
    "market/icon.svg",
    "docs/",
    "README.md",
    "README.en.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-rc.1"
  },
  "scripts": {
    "test": "node --test",
    "typecheck": "tsc -p tsconfig.json",
    "test:host": "node scripts/run-host-node.mjs --test",
    "simulate": "node scripts/simulate.js",
    "mount-check": "node scripts/run-host-node.mjs scripts/dev/mount-check.mjs",
    "market": "node scripts/run-host-node.mjs scripts/make-market-index.mjs",
    "inspect": "node scripts/run-host-node.mjs scripts/dev/inspect-session.mjs",
    "install-smoke": "node scripts/run-host-node.mjs scripts/dev/install-smoke.mjs",
    "publish:remote": "node scripts/publish-remote.mjs",
    "publish:npm": "node scripts/publish-npm.mjs",
    "publish:rehearse": "node scripts/run-host-node.mjs scripts/dev/publish-rehearse.mjs",
    "scan": "node scripts/dev/scan-sessions.mjs",
    "host-session": "node scripts/run-host-node.mjs scripts/dev/host-session-check.mjs",
    "coexist": "node scripts/run-host-node.mjs scripts/dev/coexist-check.mjs",
    "e2e-install": "node scripts/run-host-node.mjs scripts/dev/e2e-install.mjs",
    "market-install": "node scripts/run-host-node.mjs scripts/dev/market-install.mjs",
    "boot-check": "node scripts/run-host-node.mjs scripts/dev/boot-check.mjs",
    "schema-check": "node scripts/run-host-node.mjs scripts/dev/schema-check.mjs",
    "awesome": "node scripts/dev/submit-awesome.mjs",
    "verify": "node scripts/dev/verify.mjs --group core",
    "verify:host": "node scripts/dev/verify.mjs --group host",
    "verify:network": "node scripts/dev/verify.mjs --group network",
    "verify:all": "node scripts/dev/verify.mjs --group all",
    "list-pr": "node scripts/dev/submit-list.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "context-window",
    "compaction",
    "context-overflow",
    "rescue"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Lequait/dsh-context-rescue.git"
  },
  "homepage": "https://github.com/Lequait/dsh-context-rescue#readme",
  "bugs": {
    "url": "https://github.com/Lequait/dsh-context-rescue/issues"
  },
  "dependencies": {
    "schemastery": "^3.18.0"
  }
}
